.bridge-state/
.bridge-ledger/
bridge-state/
profiles/
state/
ledger/
sessions/
*.session.json

# --- logs, backups and local acceptance outputs ---
*.log
logs/
backups/
*.bak
*.bak.*
local-acceptance/
acceptance-out/
acceptance-*.json
*-acceptance.json

# --- scratch / editor / OS noise ---
*.tmp
.DS_Store
Thumbs.db
